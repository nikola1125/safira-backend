NODE_ENV=production
PORT=5000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/villa-safira

# Comma-separated list of allowed frontend origins (public site + admin)
ALLOWED_ORIGINS=https://villasafira.al,https://admin.villasafira.al

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your@email.com
EMAIL_PASSWORD=yourpassword
EMAIL_FROM=your@email.com

# Admin dashboard auth
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_EMAIL=manager@villasafira.al
ADMIN_PASSWORD=change-this-to-a-strong-password

# R2 Object Storage (Cloudflare)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=villa-safira-images
R2_PUBLIC_URL=https://your-r2-bucket.your-domain.com
